# Copiar a .env y ajustar. install.sh lo instala en /opt/honeypot/.env.

# Subred Docker del honeypot. honeypot-firewall la aísla; tiene que estar libre.
HONEYPOT_SUBNET=172.30.250.0/24

# Puertos del host. En el router: 22 → servidor:SSH_PORT y 23 → servidor:TELNET_PORT
SSH_PORT=2222
TELNET_PORT=2223

# Nombre de máquina que ve el atacante
HONEYPOT_HOSTNAME=web-prod-02

# Destinos (ip:puerto) a los que el honeypot NO debe llegar. Pon los de tu red:
# router, SSH y servicios del servidor, tu PC... La .1 de la subred del honeypot
# es el propio servidor visto desde el contenedor.
PRUEBA_DESTINOS="192.168.1.1:80 192.168.1.10:22 192.168.1.10:3306 172.30.250.1:22 172.17.0.1:80"
